# Required: Nebius Token Factory key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
# Optional: live news monitoring (https://tavily.com)
TAVILY_API_KEY=
# Optional: get Yes/No buttons on your phone through your own Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = demo inbox, outgoing mail is written to data/outbox instead of being sent
KEPT_DEMO=1
KEPT_OWNER_NAME=Alex
KEPT_TZ=America/Los_Angeles
KEPT_DAILY_BUDGET_USD=1.00
# Real mail (only used when KEPT_DEMO=0)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Where Kept keeps its files (ledger, journal, audit); defaults to ./data
KEPT_DATA_DIR=
# Token Factory endpoint and, optionally, exact model ids per tier (otherwise picked from /v1/models)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
KEPT_MODEL_NANO=
KEPT_MODEL_SUPER=
KEPT_MODEL_ULTRA=
KEPT_MODEL_VISION=
